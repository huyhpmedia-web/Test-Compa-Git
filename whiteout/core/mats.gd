static var _cache := {}

## Returns a shared StandardMaterial3D. `tile` overrides metres-per-texture-tile.
## Uses world triplanar mapping so any box/mesh size tiles correctly.
static func get_mat(name: String, tile: float = -1.0) -> StandardMaterial3D:
	var key := "%s@%.2f" % [name, tile]
	if _cache.has(key):
		return _cache[key]
	var p: Array = PRESETS.get(name, [Color(0.6, 0.6, 0.6), 0.8, 0.0, 2.0])
	var m := StandardMaterial3D.new()
	m.albedo_color = p[0]
	m.roughness = p[1]
	m.metallic = p[2]
	var t: float = p[3] if tile <= 0.0 else tile
	var base := "res://textures/%s" % name
	if ResourceLoader.exists(base + "_albedo.png"):
		m.albedo_texture = load(base + "_albedo.png")
		m.albedo_color = Color(1, 1, 1, p[0].a)
	if ResourceLoader.exists(base + "_normal.png"):
		m.normal_enabled = true
		m.normal_texture = load(base + "_normal.png")
		m.normal_scale = 1.0
	if ResourceLoader.exists(base + "_rough.png"):
		m.roughness_texture = load(base + "_rough.png")
		m.roughness = 1.0
	m.uv1_triplanar = true
	m.uv1_world_triplanar = true
	m.uv1_scale = Vector3.ONE / t
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	if name.begins_with("emissive") or name == "screen":
		m.emission_enabled = true
		m.emission = p[0]
		m.emission_energy_multiplier = 2.5
	if p[0].a < 1.0:
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	if name == "glass" or name == "water":
		m.metallic_specular = 0.8
	_cache[key] = m
	return m

## Unique flat-colour PBR material (not cached).
static func color(c: Color, rough: float = 0.8, metal: float = 0.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = rough
	m.metallic = metal
	if c.a < 1.0:
		m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	return m

static func emissive(c: Color, energy: float = 3.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.emission_enabled = true
	m.emission = c
	m.emission_energy_multiplier = energy
	return m
