#: actors/npc.gd:26
msgid "Talk to"
msgstr "Nói chuyện với"

#: actors/npc.gd:46 levels/l6_heart.gd:525
msgid "June"
msgstr "June"

#: actors/npc.gd:50 actors/npc.gd:50 levels/l5_mine.gd:1155
msgid "JUNE"
msgstr "JUNE"

#: actors/npc.gd:50
msgid "Dad. You actually came."
msgstr "Bố. Bố đến thật rồi."

#: actors/npc.gd:50
msgid "Don't look at me like that. I'm fine. I'm just cold."
msgstr "Đừng nhìn con như thế. Con ổn mà. Con chỉ hơi lạnh thôi."

#: actors/npc.gd:52
msgid "Ruth"
msgstr "Ruth"

#: actors/npc.gd:56 actors/npc.gd:56 levels/l5_mine.gd:1249
msgid "RUTH"
msgstr "RUTH"

#: actors/npc.gd:56
msgid "Elias. You're letting the cold in."
msgstr "Elias. Con làm hơi lạnh lọt vào nhà đấy."

#: actors/npc.gd:56
msgid "Tom's calling from downstairs. Can't you hear him?"
msgstr "Tom đang gọi ở dưới nhà kìa. Con không nghe thấy sao?"

#: actors/npc.gd:58
msgid "Dr. Hart"
msgstr "Tiến sĩ Hart"

#: actors/npc.gd:62 actors/npc.gd:62 levels/l4_meridian.gd:942
msgid "IMOGEN"
msgstr "IMOGEN"

#: actors/npc.gd:62
msgid "Eight months. I reported it eight months ago."
msgstr "Tám tháng. Tôi đã báo cáo từ tám tháng trước."

#: actors/npc.gd:62
msgid "I need a sample. Bring me one and I'll tell you everything."
msgstr "Tôi cần một mẫu vật. Mang đến cho tôi một cái, tôi sẽ kể anh nghe tất cả."

#: actors/npc.gd:64
msgid "Caretaker"
msgstr "Người trông trường"

#: actors/npc.gd:68 actors/npc.gd:68
msgid "CARETAKER"
msgstr "NGƯỜI TRÔNG TRƯỜNG"

#: actors/npc.gd:68
msgid "Boiler's been dead since Tuesday. I told them."
msgstr "Lò hơi chết từ hôm thứ Ba rồi. Tôi đã bảo họ."

#: actors/npc.gd:68
msgid "Something dragged Pete down the hall. Heavy. Slow."
msgstr "Có thứ gì đó lôi Pete đi dọc hành lang. Nặng nề. Chậm rãi."

#: actors/npc.gd:70
msgid "Frozen miner"
msgstr "Thợ mỏ đông cứng"

#: actors/npc.gd:70
msgid "Examine"
msgstr "Xem xét"

#: actors/npc.gd:74
msgid "A miner. Frozen where he lay down to rest. A crystal grows from his open mouth."
msgstr "Một người thợ mỏ. Đông cứng ngay tại chỗ ông nằm xuống nghỉ. Một khối tinh thể mọc ra từ cái miệng đang há."

#: core/game.gd:1
msgid "CAUTION"
msgstr "CẨN TRỌNG"

#: core/game.gd:1
msgid "DANGER"
msgstr "NGUY HIỂM"

#: core/game.gd:150
#, c-format
msgid "OBJECTIVE: %s"
msgstr "MỤC TIÊU: %s"

#: core/game.gd:248
msgid "You are already in good condition."
msgstr "Sức khỏe vẫn đang tốt."

#: core/game.gd:263
#, c-format
msgid "Inventory expanded to %d slots."
msgstr "Túi đồ được mở rộng lên %d ô."

#: core/game.gd:270
msgid "You strike a flare."
msgstr "Quẹt cháy một quả pháo sáng."

#: core/game.gd:272
msgid "Combine it with something."
msgstr "Phải kết hợp nó với thứ khác."

#: core/game.gd:277 levels/l1_substation.gd:1296 levels/l4_meridian.gd:1136
msgid "There is nothing to use it on here."
msgstr "Ở đây không có gì để dùng nó."

#: core/game.gd:283
msgid "These can't be combined."
msgstr "Hai thứ này không thể kết hợp với nhau."

#: core/game.gd:289
#, c-format
msgid "Created: %s"
msgstr "Đã tạo ra: %s"

#: core/game.gd:308
msgid "Progress recorded."
msgstr "Đã ghi lại tiến trình."

#: core/items.gd:7
msgid "Lineman's Hatchet"
msgstr "Rìu thợ đường dây"

#: core/items.gd:7
msgid "A short-handled hatchet from the truck. Quiet. Reliable. Close."
msgstr "Chiếc rìu cán ngắn lấy từ xe tải. Êm. Đáng tin. Dùng khi áp sát."

#: core/items.gd:8
msgid "M45 Pistol"
msgstr "Súng lục M45"

#: core/items.gd:8
msgid "Elias's old service pistol, kept in the truck's lockbox. 12-round magazine."
msgstr "Khẩu súng lục phục vụ cũ của Elias, cất trong hộp khóa trên xe tải. Hộp đạn 12 viên."

#: core/items.gd:9
msgid "Pump Shotgun"
msgstr "Súng săn Pump"

#: core/items.gd:9
msgid "A hardware-store duck gun. Devastating up close; cracks ice armour."
msgstr "Khẩu súng săn vịt mua ở cửa hàng ngũ kim. Cực mạnh ở cự ly gần; phá được lớp giáp băng."

#: core/items.gd:10
msgid "Tom's Revolver"
msgstr "Revolver của Tom"

#: core/items.gd:10
msgid "Your father's .44. Mom kept it in the shelter office. Pierces through targets."
msgstr "Khẩu .44 của bố. Mẹ cất nó trong văn phòng khu trú ẩn. Xuyên qua nhiều mục tiêu."

#: core/items.gd:11
msgid "Flare Launcher"
msgstr "Súng phóng pháo sáng"

#: core/items.gd:11
msgid "A marine signal launcher modified by Meridian security. Incendiary burst. The Rimebound fear it."
msgstr "Súng phóng tín hiệu hàng hải do an ninh Meridian cải tạo. Nổ cháy. Lũ Xác Băng sợ nó."

#: core/items.gd:13
msgid "9mm Rounds"
msgstr "Đạn 9mm"

#: core/items.gd:13
msgid "Pistol ammunition."
msgstr "Đạn súng lục."

#: core/items.gd:14
msgid "12ga Shells"
msgstr "Đạn săn 12ga"

#: core/items.gd:14
msgid "Shotgun shells."
msgstr "Đạn dành cho súng săn."

#: core/items.gd:15
msgid ".44 Rounds"
msgstr "Đạn .44"

#: core/items.gd:15
msgid "Heavy revolver rounds."
msgstr "Đạn revolver hạng nặng."

#: core/items.gd:16
msgid "Incendiary Flares"
msgstr "Pháo sáng cháy"

#: core/items.gd:16
msgid "40mm incendiary flares for the launcher."
msgstr "Pháo sáng cháy 40mm dành cho súng phóng."

#: core/items.gd:17
msgid "Gunpowder"
msgstr "Thuốc súng"

#: core/items.gd:17
msgid "Combine two to make pistol rounds."
msgstr "Kết hợp hai gói để làm đạn súng lục."

#: core/items.gd:18
msgid "Road Flare"
msgstr "Pháo sáng đường bộ"

#: core/items.gd:18
msgid "A magnesium road flare. Light it (use) to burn nearby Rimebound and drive them back for a while."
msgstr "Một que pháo sáng magiê dùng trên đường. Châm lửa (dùng) để thiêu lũ Xác Băng ở gần và đẩy lùi chúng một lúc."

#: core/items.gd:20
msgid "Bandage Roll"
msgstr "Cuộn băng gạc"

#: core/items.gd:20
msgid "Restores some health. Combine with Painkillers."
msgstr "Hồi phục một ít sức khỏe. Kết hợp với Thuốc giảm đau."

#: core/items.gd:21
msgid "Painkillers"
msgstr "Thuốc giảm đau"

#: core/items.gd:21
msgid "Not enough alone. Combine with a Bandage Roll."
msgstr "Một mình thì chưa đủ. Kết hợp với Cuộn băng gạc."

#: core/items.gd:22
msgid "Field Dressing"
msgstr "Băng cứu thương dã chiến"

#: core/items.gd:22
msgid "Bandage + painkillers. Fully restores health."
msgstr "Băng gạc + thuốc giảm đau. Hồi phục hoàn toàn sức khỏe."

#: core/items.gd:23
msgid "Trauma Kit"
msgstr "Bộ sơ cứu chấn thương"

#: core/items.gd:23
msgid "A co-op first-responder kit. Fully restores health."
msgstr "Bộ dụng cụ của lực lượng cứu hộ hợp tác xã. Hồi phục hoàn toàn sức khỏe."

#: core/items.gd:25
msgid "Tool Pouch"
msgstr "Túi dụng cụ"

#: core/items.gd:25
msgid "Use to expand inventory by 2 slots."
msgstr "Dùng để mở rộng túi đồ thêm 2 ô."

#: core/items.gd:27
msgid "Handheld Radio"
msgstr "Bộ đàm cầm tay"

#: core/items.gd:27
msgid "Tuned to 146.52 MHz. June's frequency."
msgstr "Đã chỉnh sang tần số 146,52 MHz. Tần số của June."

#: core/items.gd:28
msgid "Hot Stick"
msgstr "Gậy cách điện"

#: core/items.gd:28
msgid "An insulated fibreglass switching pole for operating energised disconnects."
msgstr "Cây sào thao tác bằng sợi thủy tinh cách điện, dùng để đóng cắt dao cách ly đang có điện."

#: core/items.gd:29
msgid "Control House Key"
msgstr "Chìa khóa nhà điều khiển"

#: core/items.gd:29
msgid "Brass key tagged 'KF SUBSTATION — CONTROL HOUSE'."
msgstr "Chìa khóa đồng gắn thẻ 'TRẠM BIẾN ÁP KF — NHÀ ĐIỀU KHIỂN'."

#: core/items.gd:30
msgid "60A Fuse"
msgstr "Cầu chì 60A"

#: core/items.gd:30
msgid "A 60-amp cartridge fuse."
msgstr "Một cầu chì ống 60 ampe."

#: core/items.gd:31
msgid "Janitor's Keyring"
msgstr "Chùm chìa khóa người gác trường"

#: core/items.gd:31
msgid "Heavy keyring. Tag: 'KFCS — CUSTODIAL'. Opens the main hall and the boiler room."
msgstr "Chùm chìa khóa nặng trịch. Thẻ ghi: 'KFCS — TẠP VỤ'. Mở được sảnh chính và phòng lò hơi."

#: core/items.gd:32
msgid "Valve Wheel"
msgstr "Tay quay van"

#: core/items.gd:32
msgid "A detachable cast-iron valve wheel from the boiler room."
msgstr "Tay quay van bằng gang, tháo rời được, lấy từ phòng lò hơi."

#: core/items.gd:33
msgid "Gym Padlock Key"
msgstr "Chìa khóa móc phòng thể dục"

#: core/items.gd:33
msgid "Small key on a whistle lanyard."
msgstr "Chiếc chìa khóa nhỏ buộc vào dây đeo còi."

#: core/items.gd:34
msgid "Sacristy Key"
msgstr "Chìa khóa phòng áo lễ"

#: core/items.gd:34
msgid "An old iron key. Father Okafor's handwriting on the tag: 'side door'."
msgstr "Một chiếc chìa khóa sắt cũ. Trên thẻ là nét chữ của Cha Okafor: 'cửa hông'."

#: core/items.gd:35
msgid "Bell Pull Handle"
msgstr "Tay nắm dây chuông"

#: core/items.gd:35
msgid "The handle for the church bell's pull chain."
msgstr "Tay nắm của dây xích kéo chuông nhà thờ."

#: core/items.gd:36
msgid "Ruth's Rosary"
msgstr "Chuỗi tràng hạt của Ruth"

#: core/items.gd:36
msgid "Your mother's rosary. The beads are rimed with frost that never melts."
msgstr "Chuỗi tràng hạt của mẹ. Những hạt cườm phủ một lớp sương muối không bao giờ tan."

#: core/items.gd:37
msgid "Meridian Access Badge"
msgstr "Thẻ ra vào Meridian"

#: core/items.gd:37
msgid "Contractor badge, cold to the touch. CORVANE SYSTEMS — MERIDIAN SITE."
msgstr "Thẻ nhà thầu, lạnh buốt khi chạm vào. CORVANE SYSTEMS — CƠ SỞ MERIDIAN."

#: core/items.gd:38
msgid "Cooling Plant Key"
msgstr "Chìa khóa nhà máy làm mát"

#: core/items.gd:38
msgid "A red key for the chiller plant's manual overrides."
msgstr "Chiếc chìa khóa đỏ dùng cho các cơ cấu điều khiển tay của nhà máy làm lạnh."

#: core/items.gd:39
msgid "Pipeline Override Card"
msgstr "Thẻ ghi đè đường ống"

#: core/items.gd:39
msgid "Imogen's override card for the heat-recovery pipeline service tunnel."
msgstr "Thẻ ghi đè của Imogen, dùng cho đường hầm kỹ thuật của đường ống thu hồi nhiệt."

#: core/items.gd:40
msgid "Cap-Lamp Battery"
msgstr "Pin đèn đội đầu"

#: core/items.gd:40
msgid "A charged miner's cap-lamp battery pack."
msgstr "Một bộ pin đã sạc cho đèn đội đầu của thợ mỏ."

#: core/items.gd:41
msgid "Hoist Brake Lever"
msgstr "Cần phanh tời"

#: core/items.gd:41
msgid "The removable brake lever for the old hoist."
msgstr "Cần phanh có thể tháo rời của chiếc tời cũ."

#: core/items.gd:42
msgid "Blasting Charges"
msgstr "Thuốc nổ phá đá"

#: core/items.gd:42
msgid "Two sticks of old Northline blasting gel and a detonator."
msgstr "Hai thỏi thuốc nổ gel cũ của Northline cùng một kíp nổ."

#: core/items.gd:43
msgid "Tom's Brass Tag"
msgstr "Thẻ đồng của Tom"

#: core/items.gd:43
msgid "Miner's check-in tag no. 114. T. KADE. It was never collected in 2011."
msgstr "Thẻ điểm danh của thợ mỏ số 114. T. KADE. Năm 2011 chưa có ai đến nhận."

#: levels/l1_substation.gd:66 levels/l1_substation.gd:1247
msgid "Reach the school. Gran's shelter. Follow Highway 53 north."
msgstr "Đến trường học. Nơi trú ẩn của bà. Đi theo Quốc lộ 53 về hướng bắc."

#: levels/l1_substation.gd:70
msgid "Get into Kettle Falls. Follow Highway 53 north on foot."
msgstr "Vào Kettle Falls. Đi bộ theo Quốc lộ 53 về hướng bắc."

#: levels/l1_substation.gd:71
msgid "HIGHWAY 53"
msgstr "QUỐC LỘ 53"

